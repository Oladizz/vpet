<Window x:Class="VPet.SmartPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartPet — AI Pet Settings"
        Width="520" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Header -->
            <TextBlock Text="SmartPet — your AI desktop pet assistant"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray"
                       Text="Your pet watches which apps you use and how long, talks to you, and answers questions with Gemini AI. Local commands never use the API, so your costs stay tiny."/>

            <Separator Margin="0,10"/>

            <!-- AI section -->
            <TextBlock Text="AI Chat (Gemini)" FontWeight="Bold" FontSize="14"/>
            <Label Content="Gemini API key"/>
            <TextBox x:Name="ApiKeyBox" ToolTip="Get one free at https://aistudio.google.com/app/apikey"/>
            <Label Content="Model (cheaper models = lower cost)"/>
            <TextBox x:Name="ModelBox" Text="gemini-2.5-flash"/>
            <Label Content="Pet's name"/>
            <TextBox x:Name="PetNameBox" Text="Buddy"/>
            <Label Content="Max AI requests per day (safety cap)"/>
            <TextBox x:Name="MaxRequestsBox" Text="100"/>

            <Separator Margin="0,10"/>

            <!-- Voice section -->
            <TextBlock Text="Voice Commands" FontWeight="Bold" FontSize="14"/>
            <CheckBox x:Name="VoiceEnabledBox" Content="Enable voice commands (needs a microphone)"/>
            <Label Content="Wake word (say this before talking)"/>
            <TextBox x:Name="WakeWordBox" Text="hey buddy"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                       Text="Free local commands (never use the API): come here, go left/right/top/bottom, follow me, go sleep, wake up, hide, show yourself, dance, lie down, stats, what app am i using, good boy, i love you, turn off voice..."/>

            <Separator Margin="0,10"/>

            <!-- Behavior section -->
            <TextBlock Text="Behavior" FontWeight="Bold" FontSize="14"/>
            <Label Content="Usage commentary interval (seconds)"/>
            <TextBox x:Name="CommentIntervalBox" Text="300"/>
            <Label Content="Minimum app focus time before tracking (seconds)"/>
            <TextBox x:Name="MinFocusBox" Text="60"/>

            <Separator Margin="0,10"/>

            <!-- 3D section -->
            <TextBlock Text="Renderer (2D / 3D)" FontWeight="Bold" FontSize="14"/>
            <CheckBox x:Name="Use3DBox" Content="Use 3D model renderer (advanced)"/>
            <Label Content="3D model file (.glb / .gltf)"/>
            <TextBox x:Name="ModelPathBox"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                       Text="The pet ships with the classic 2D sprite. Point this at a glTF model to switch to 3D — see README.md for the upgrade path."/>

            <Separator Margin="0,10"/>

            <!-- Usage stats preview -->
            <TextBlock Text="App Usage Stats (live preview)" FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="StatsText" Text="Tracking..." Foreground="Gray" Margin="0,6,0,10"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="90" Margin="0,0,8,0"
                        Click="SaveButton_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
